# PlatformIO / build outputs (re-downloadable or regenerable)
.pio
# Per-target PlatformIO package roots used by tools/pio-target.ps1 to keep the
# two firmware targets from reinstalling each other's framework packages.
.pio-pkgs
# Repository-local PlatformIO core dir (holds platforms.lock and junctions to
# the shared platform installation) so builds need no access outside the repo.
.pio-core
bridge/target
bridge/crates/app/gen
bridge/target-note4-deploy/
bridge/target-note4-sync/

# Local working artifacts (camera captures, previews, logs)
artifacts/

# Third-party font sources and the vendored freetype-py wheel for
# tools/note4-fonts (downloaded, not needed for a build: the generated headers
# and the .bin assets are what ships)
tools/note4-fonts/vendor/

# Runtime logs
tools/test-bridge/bridge.log
tools/test-bridge/bridge.err

# Python
__pycache__/
*.pyc

# Editor / OS noise
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
Thumbs.db
desktop.ini

# pioarduino custom_sdkconfig droppings (regenerated per build)
sdkconfig
sdkconfig.old
sdkconfig.defaults
sdkconfig.*
CMakeLists.txt
.dummy/
dependencies.lock
managed_components/
