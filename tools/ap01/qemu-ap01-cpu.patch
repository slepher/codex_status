+/* AP01's observed historical P encoding, not the current draft P ISA. */
+static bool trans_ap01_insb(DisasContext *ctx, arg_ap01_insb *a)
+{
+    TCGv dest, old, source;
+
+    REQUIRE_32BIT(ctx);
+    if (!ctx->cfg_ptr->ext_xap01p) {
+        return false;
+    }
+    dest = dest_gpr(ctx, a->rd);
+    old = get_gpr(ctx, a->rd, EXT_ZERO);
+    source = get_gpr(ctx, a->rs1, EXT_ZERO);
+    tcg_gen_deposit_tl(dest, old, source, a->imm * 8, 8);
+    gen_set_gpr(ctx, a->rd, dest);
+    return true;
+}
+
+/* SDK core_feature_dsp.h PKBB16: concat(rs1.low16, rs2.low16).
+ * Only the historical opcode77/funct7=7/funct3=1 observed at 0041 UART
+ * init a0025ff0 is decoded; no other draft P encoding is implied. */
+static bool trans_ap01_pkbb16(DisasContext *ctx, arg_ap01_pkbb16 *a)
+{
+    TCGv dest, upper, lower;
+
+    REQUIRE_32BIT(ctx);
+    if (!ctx->cfg_ptr->ext_xap01p) {
+        return false;
+    }
+    dest = dest_gpr(ctx, a->rd);
+    upper = get_gpr(ctx, a->rs1, EXT_ZERO);
+    lower = get_gpr(ctx, a->rs2, EXT_ZERO);
+    tcg_gen_deposit_tl(dest, lower, upper, 16, 16);
+    gen_set_gpr(ctx, a->rd, dest);
+    return true;
+}
+
+/* Historical P ADD64, observed c0e51577 at original RAM62fc18b4
+ * (matching original file offset23c8). SDK core_feature_dsp.h ADD64 uses
+ * Rx[4:1] to select even/odd pairs; bit0 is ignored, not reserved.
+ * Full pair reads precede writes, including x0/x1 and aliasing pairs.
+ * Encoding corroborated by OpenOCD MATCH_ADD64=c0001077/maskfe00707f. */
+static bool ap01_addsub64(DisasContext *ctx, arg_r *a, bool subtract)
+{
+    TCGv_i32 al = tcg_temp_new_i32(), ah = tcg_temp_new_i32();
+    TCGv_i32 bl = tcg_temp_new_i32(), bh = tcg_temp_new_i32();
+    TCGv_i32 low = tcg_temp_new_i32(), high = tcg_temp_new_i32();
+    TCGv result = tcg_temp_new();
+    int rd = a->rd & ~1, rs1 = a->rs1 & ~1, rs2 = a->rs2 & ~1;
+
+    REQUIRE_32BIT(ctx);
+    if (!ctx->cfg_ptr->ext_xap01p) {
+        return false;
+    }
+    tcg_gen_trunc_tl_i32(al, get_gpr(ctx, rs1, EXT_ZERO));
+    tcg_gen_trunc_tl_i32(ah, get_gpr(ctx, rs1 + 1, EXT_ZERO));
+    tcg_gen_trunc_tl_i32(bl, get_gpr(ctx, rs2, EXT_ZERO));
+    tcg_gen_trunc_tl_i32(bh, get_gpr(ctx, rs2 + 1, EXT_ZERO));
+    if (subtract) {
+        tcg_gen_sub2_i32(low, high, al, ah, bl, bh);
+    } else {
+        tcg_gen_add2_i32(low, high, al, ah, bl, bh);
+    }
+    tcg_gen_extu_i32_tl(result, low);
+    gen_set_gpr(ctx, rd, result);
+    tcg_gen_extu_i32_tl(result, high);
+    gen_set_gpr(ctx, rd + 1, result);
+    return true;
+}
+
+static bool trans_ap01_add64(DisasContext *ctx, arg_ap01_add64 *a)
+{
+    return ap01_addsub64(ctx, a, false);
+}
+
+/* SUB64 c2c71777 observed at original a01a40f6. SDK SUB64 uses the
+ * same pair selection as ADD64, with subtraction modulo2^64. */
+static bool trans_ap01_sub64(DisasContext *ctx, arg_ap01_sub64 *a)
+{
+    return ap01_addsub64(ctx, a, true);
+}
+
+/* Historical MULR64 observed f0a79977 at original a002cb1c.
+ * SDK core_feature_dsp.h MULR64: unsigned32(rs1)*unsigned32(rs2),
+ * destination pair selected by rd[4:1]; source fields are SINGLE registers.
+ * Capture both inputs before pair writes (including high-register aliases). */
+static bool trans_ap01_mulr64(DisasContext *ctx, arg_ap01_mulr64 *a)
+{
+    TCGv_i32 left = tcg_temp_new_i32(), right = tcg_temp_new_i32();
+    TCGv_i32 low = tcg_temp_new_i32(), high = tcg_temp_new_i32();
+    TCGv result = tcg_temp_new();
+    int rd = a->rd & ~1;
+
+    REQUIRE_32BIT(ctx);
+    if (!ctx->cfg_ptr->ext_xap01p) {
+        return false;
+    }
+    tcg_gen_trunc_tl_i32(left, get_gpr(ctx, a->rs1, EXT_ZERO));
+    tcg_gen_trunc_tl_i32(right, get_gpr(ctx, a->rs2, EXT_ZERO));
+    tcg_gen_mulu2_i32(low, high, left, right);
+    tcg_gen_extu_i32_tl(result, low);
+    gen_set_gpr(ctx, rd, result);
+    tcg_gen_extu_i32_tl(result, high);
+    gen_set_gpr(ctx, rd + 1, result);
+    return true;
+}
+
+/* MAXW f34a8a77 observed at original a00177ae in TXCAL.
+ * Fixed SDK core_feature_dsp.h5948: signed32 maximum, SE result.
+ * Decode only historical opcode77/funct7=79/funct3=0, RV32 opt-in. */
+static bool trans_ap01_maxw(DisasContext *ctx, arg_ap01_maxw *a)
+{
+    TCGv_i32 left = tcg_temp_new_i32(), right = tcg_temp_new_i32();
+    TCGv_i32 maximum = tcg_temp_new_i32();
+    TCGv result = tcg_temp_new();
+
+    REQUIRE_32BIT(ctx);
+    if (!ctx->cfg_ptr->ext_xap01p) {
+        return false;
+    }
+    tcg_gen_trunc_tl_i32(left, get_gpr(ctx, a->rs1, EXT_ZERO));
+    tcg_gen_trunc_tl_i32(right, get_gpr(ctx, a->rs2, EXT_ZERO));
+    tcg_gen_smax_i32(maximum, left, right);
+    tcg_gen_ext_i32_tl(result, maximum);
+    gen_set_gpr(ctx, a->rd, result);
+    return true;
+}
+
+/* SWAP8 ad890977 observed at original a0138faa in Wi-Fi initialization.
+ * SDK core_feature_dsp.h SWAP8 swaps bytes independently in each halfword.
+ * Only observed historical opcode77/subf5=24 is enabled, not the other
+ * oneop operations or draft opcode3f. */
+static bool trans_ap01_swap8(DisasContext *ctx, arg_ap01_swap8 *a)
+{
+    TCGv dest, source, low, high;
+
+    REQUIRE_32BIT(ctx);
+    if (!ctx->cfg_ptr->ext_xap01p) {
+        return false;
+    }
+    dest = dest_gpr(ctx, a->rd);
+    source = get_gpr(ctx, a->rs1, EXT_ZERO);
+    low = tcg_temp_new();
+    high = tcg_temp_new();
+    tcg_gen_andi_tl(low, source, 0x00ff00ff);
+    tcg_gen_shli_tl(low, low, 8);
+    tcg_gen_shri_tl(high, source, 8);
+    tcg_gen_andi_tl(high, high, 0x00ff00ff);
+    tcg_gen_or_tl(dest, low, high);
+    gen_set_gpr(ctx, a->rd, dest);
+    return true;
+}
+
+/* UMAR64 a4d61777 observed at original a0048258.
+ * Legacy P spec15335ff and SDK core_feature_dsp.h12648ff: RV32 adds
+ * unsigned32(rs1)*unsigned32(rs2) to pair rd[4:1], modulo2^64.
+ * Odd rd is an alias, not illegal. Capture accumulator and SINGLE sources
+ * before any writes, including x0/x1 and destination/source overlap. */
+static bool trans_ap01_umar64(DisasContext *ctx, arg_ap01_umar64 *a)
+{
+    TCGv_i32 al = tcg_temp_new_i32(), ah = tcg_temp_new_i32();
+    TCGv_i32 left = tcg_temp_new_i32(), right = tcg_temp_new_i32();
+    TCGv_i32 pl = tcg_temp_new_i32(), ph = tcg_temp_new_i32();
+    TCGv_i32 low = tcg_temp_new_i32(), high = tcg_temp_new_i32();
+    TCGv result = tcg_temp_new();
+    int rd = a->rd & ~1;
+
+    REQUIRE_32BIT(ctx);
+    if (!ctx->cfg_ptr->ext_xap01p) {
+        return false;
+    }
+    tcg_gen_trunc_tl_i32(al, get_gpr(ctx, rd, EXT_ZERO));
+    tcg_gen_trunc_tl_i32(ah, get_gpr(ctx, rd + 1, EXT_ZERO));
+    tcg_gen_trunc_tl_i32(left, get_gpr(ctx, a->rs1, EXT_ZERO));
+    tcg_gen_trunc_tl_i32(right, get_gpr(ctx, a->rs2, EXT_ZERO));
+    tcg_gen_mulu2_i32(pl, ph, left, right);
+    tcg_gen_add2_i32(low, high, al, ah, pl, ph);
+    tcg_gen_extu_i32_tl(result, low);
+    gen_set_gpr(ctx, rd, result);
+    tcg_gen_extu_i32_tl(result, high);
+    gen_set_gpr(ctx, rd + 1, result);
+    return true;
+}
+
 #define REQUIRE_XTHEADBA(ctx) do {               \
     if (!ctx->cfg_ptr->ext_xtheadba) {           \
         return false;                            \
