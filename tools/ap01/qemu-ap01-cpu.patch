+++ b/target/riscv/csr.c
@@ -2987,6 +2987,16 @@ static RISCVException write_mtvec(CPURISCVState *env, int csrno,
     /* bits [1:0] encode mode; 0 = direct, 1 = vectored, 2 >= reserved */
     if ((val & 3) < 2) {
         env->mtvec = val;
+    } else if ((val & 3) == 3 && riscv_cpu_cfg(env)->ext_xap01clic &&
+               riscv_cpu_mxl(env) == MXL_RV32 && !(val & 0x3c)) {
+        /* Restricted AP01 non-SHV common-trap adapter. Original 0041
+         * installs 0x62fc2503. Require a 64-byte-aligned base explicitly;
+         * do not invent WARL rounding for unsupported low base bits.
+         * The board must gate IRQ7 with CLIC IP/IE and reject unsupported
+         * SHV, priorities/thresholds and nesting configurations. This flag
+         * does not implement a complete E907/CLIC CPU or vector dispatch.
+         */
+        env->mtvec = val;
     } else {
         qemu_log_mask(LOG_UNIMP, "CSR_MTVEC: reserved mode not supported\n");
     }
